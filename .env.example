# Copia este archivo como .env (no se sube a git).

# ElevenLabs (cuando se contrate el plan Starter o superior para licencia comercial)
ELEVENLABS_API_KEY=

# Modelo de Whisper para tiempos por palabra (large-v3-turbo = mejor relación calidad/velocidad)
WHISPER_MODEL=large-v3-turbo

# Modelo Qwen3-TTS (1.7B = mejor calidad; 0.6B = más rápido)
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
